profile: production

skip_list: []

warn_list: []

enable_list:
  - args
  - empty-string-compare
  - no-log-password
  - no-same-owner
  - no-prompting
  - role-argument-spec

use_default_rules: true
offline: false

exclude_paths:
  - .cache/
  - .git/
  - .venv/
  - collections/
  - "*.sops.yaml"
  - secrets/

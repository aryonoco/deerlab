profile: production

skip_list: []

warn_list: []

enable_list:
  - args
  - empty-string-compare
  - no-log-password
  - no-same-owner
  - no-prompting
  - role-argument-spec

use_default_rules: true
offline: false

exclude_paths:
  - .cache/
  - .git/
  - .venv/
  - collections/
  # ansible-lint's own copy of the collections, which it follows into when a
  # play names a collection's role statically (ci/sops.yml). Third-party code,
  # like collections/.
  - .ansible/
  - "*.sops.yaml"
  - secrets/

#!/usr/sbin/nft -f
# {{ deerlab_managed }}
# Never `systemctl stop nftables`: Debian's unit flushes every rule on stop.
flush ruleset

table inet deerlab {
{# Per-source SSH budgets: scanners cannot use up the operator's. #}
  set ssh_rate4 { type ipv4_addr; flags dynamic, timeout; timeout 1m; }
  set ssh_rate6 { type ipv6_addr; flags dynamic, timeout; timeout 1m; }

{% for name, svc in base_firewall_services.items() %}
  chain svc_{{ name }} {
{% if svc.egress == 'any' %}
    accept
{% elif svc.egress in ('web', 'platform', 'mail', 'public') %}
{# The resolver accepts come first on purpose. drop is terminal, so if a #}
{# resolver ever sits inside a private range - a stub on 127.0.0.53, a LAN #}
{# resolver, a link-local metadata address - a drop placed above would make #}
{# its own accept unreachable and silently break DNS for the whole class. #}
{% for resolver in base_firewall_resolvers %}
    {{ 'ip6' if ':' in resolver else 'ip' }} daddr {{ resolver }} udp dport 53 accept
    {{ 'ip6' if ':' in resolver else 'ip' }} daddr {{ resolver }} tcp dport 53 accept
{% endfor %}
    ip daddr { {{ base_firewall_private_v4 | join(', ') }} } counter drop
    ip6 daddr { {{ base_firewall_private_v6 | join(', ') }} } counter drop
{% if svc.egress == 'public' %}
{# public is any TCP port, but only to public addresses, for a service whose #}
{# routes reach sites on arbitrary ports. With every port open, the host's #}
{# own addresses need a drop of their own: a packet for any of them leaves #}
{# by lo, and the input chain accepts lo, so a request-forgery bug could #}
{# otherwise reach sshd and every backend a neighbour publishes on the #}
{# wildcard address. UDP stays DNS-only, as in web, platform and mail. #}
    fib daddr type local counter drop
    meta l4proto tcp accept
{% else %}
{# platform is web without port 80. Both still need DNS and 443, because the #}
{# service user itself pulls the image, runs restic and posts to Pushover. #}
{# No class can deny everything, which is why there is no longer one that #}
{# claims to. mail is platform plus 465, SMTP submission over implicit TLS, #}
{# for an application that sends its own mail through a relay. Like the #}
{# others it is port-based: 465 is open to any public address. #}
    tcp dport { {{ {'web': '80, 443', 'platform': '443', 'mail': '443, 465'}[svc.egress] }} } accept
{% endif %}
    limit rate 10/minute log prefix "nft-out-{{ name }} " level info
    counter drop
{% else %}
{# Reached only if base_firewall_egress_classes gains a class this template #}
{# has no branch for. Kept because an empty chain returns to output, whose #}
{# policy is accept - deleting this would turn that mistake into a service #}
{# with no egress control at all. #}
    limit rate 10/minute log prefix "nft-out-{{ name }} " level info
    counter drop
{% endif %}
  }

{% endfor %}
  chain input {
    type filter hook input priority filter; policy drop;
    ct state established,related accept
    ct state invalid drop
    iifname "lo" accept
{# Tailscale's own anti-spoofing drop, mirrored for IPv6 too: it also covers #}
{# the seconds between a reload of this ruleset and tailscaled's restart. #}
    iifname != "{{ base_firewall_tailscale_interface }}" ip saddr {{ base_firewall_tailnet_v4 }} drop
    iifname != "{{ base_firewall_tailscale_interface }}" ip6 saddr {{ base_firewall_tailnet_v6 }} drop
{# Admits the tailnet: an accept in tailscaled's own table cannot override #}
{# this chain's drop policy. What reaches each port is the tailnet policy's. #}
    iifname "{{ base_firewall_tailscale_interface }}" accept
    meta l4proto icmp icmp type { echo-request, destination-unreachable, time-exceeded, parameter-problem } accept
    meta l4proto icmpv6 icmpv6 type { echo-request, destination-unreachable, packet-too-big, time-exceeded, parameter-problem, nd-neighbor-solicit, nd-neighbor-advert, nd-router-advert, nd-router-solicit, mld-listener-query } accept
    tcp dport {{ base_firewall_ssh_port }} ct state new update @ssh_rate4 { ip saddr limit rate over 10/minute burst 10 packets } drop
    tcp dport {{ base_firewall_ssh_port }} ct state new update @ssh_rate6 { ip6 saddr limit rate over 10/minute burst 10 packets } drop
    tcp dport {{ base_firewall_ssh_port }} ct state new accept
{% if base_firewall_role == 'edge' %}
{# Caddy's own ports only as the redirect's target: the internet sees 80 and #}
{# 443. Loopback and the tailnet reach them directly through the accepts above. #}
    tcp dport { {{ base_firewall_edge_tcp_redirects.values() | join(', ') }} } ct status dnat accept
    udp dport { {{ base_firewall_edge_udp_redirects.values() | join(', ') }} } ct status dnat accept
    udp dport {{ base_firewall_tailscale_port }} accept
    udp dport {{ base_firewall_wg_port }} accept
{% else %}
{% if base_firewall_peer_public_v4 | length > 0 %}
    ip saddr {{ base_firewall_peer_public_v4 }} udp dport {{ base_firewall_wg_port }} ct state new accept
{% endif %}
{% for proto, ports in [('tcp', base_firewall_backend_tcp_ports), ('udp', base_firewall_backend_udp_ports)] %}
{% if ports | length > 0 %}
    iifname "{{ base_firewall_wg_interface }}" ip saddr {{ base_firewall_peer_ipv4 }} {{ proto }} dport { {{ ports | join(', ') }} } ct state new accept
{% if base_firewall_peer_ipv6 | length > 0 %}
    iifname "{{ base_firewall_wg_interface }}" ip6 saddr {{ base_firewall_peer_ipv6 }} {{ proto }} dport { {{ ports | join(', ') }} } ct state new accept
{% endif %}
{% endif %}
{% endfor %}
{% endif %}
    limit rate 5/minute log prefix "nft-in-drop " level info
  }

  chain forward {
    type filter hook forward priority filter; policy drop;
  }

  chain output {
    type filter hook output priority filter; policy accept;
    ct state established,related accept
    ct state invalid drop
    meta skuid 0 accept
{% for name, svc in base_firewall_services.items() %}
    meta skuid {{ svc.uid }} jump svc_{{ name }}
{% endfor %}
{# Below the per-UID jumps on purpose. Linux routes a packet addressed to any #}
{# local address out lo - 127.0.0.0/8, the host's own public addresses and #}
{# its own tunnel address alike - so an accept placed above the jumps exempts #}
{# every egress class from its own rules, and a request-forgery bug in a #}
{# confined service could reach sshd or anything a neighbour publishes on the #}
{# wildcard address. The svc chains emit their resolver accepts before the #}
{# private-range drops, so a loopback stub resolver keeps working from here. #}
    oifname "lo" accept
  }
{% if base_firewall_role == 'edge' %}

  chain prerouting_nat {
    type nat hook prerouting priority dstnat; policy accept;
{% for from, to in base_firewall_edge_tcp_redirects.items() %}
    iifname != "lo" tcp dport {{ from }} redirect to :{{ to }}
{% endfor %}
{% for from, to in base_firewall_edge_udp_redirects.items() %}
    iifname != "lo" udp dport {{ from }} redirect to :{{ to }}
{% endfor %}
  }
{% endif %}
}

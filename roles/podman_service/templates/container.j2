# {{ deerlab_managed }}
# Podman 5.4.2 Quadlet. Only keys that exist in 5.4.2 belong here.
[Unit]
Description={{ podman_service_container_name }}
OnFailure=notify-failure@%n.service
{% if podman_service_parent_unit | length > 0 %}
{# Names the GENERATED unit, not the .container file. Quadlet only learned to #}
{# resolve a .container in a dependency directive in 5.5; the targets run     #}
{# 5.4.2. After= orders migrations, which the primary container runs, before  #}
{# this one starts. PartOf= makes one `systemctl stop <service>` take both    #}
{# down, so a restore cannot stop half the service and rewrite the volume     #}
{# underneath a live writer.                                                  #}
After={{ podman_service_parent_unit }}
PartOf={{ podman_service_parent_unit }}
{% endif %}
{# Without this, systemd's defaults (10s interval, burst 5) never trip: at    #}
{# RestartSec=5 a unit manages about two restarts inside a 10s window, never  #}
{# reaches the burst, and so never enters failed. OnFailure=notify-failure@   #}
{# above only fires on that transition, so a crash loop would run forever    #}
{# with no alert - the only alarm a container with no health check has.      #}
StartLimitIntervalSec=300

[Container]
ContainerName={{ podman_service_container_name }}
Image={{ podman_service_container_spec.image }}
Pull=never
{% if podman_service_container_spec.user is defined %}
User={{ podman_service_container_spec.user }}
{% endif %}
{% if podman_service_container_spec.group is defined %}
Group={{ podman_service_container_spec.group }}
{% endif %}
{% for port in podman_service_container_spec.publish | default([]) %}
PublishPort={{ port }}
{% endfor %}
{% if podman_service_container_spec.network is defined %}
Network={{ podman_service_container_spec.network }}
{% endif %}
{% for volume in podman_service_container_spec.volumes | default([]) %}
{# :U makes Podman chown the volume's contents to the container user at every #}
{# start. Needed when User= is set and the image ships content at the mount   #}
{# point: Podman's copy-up into a fresh volume lands root-owned, and the      #}
{# container then cannot write. Applied to the primary container only - a     #}
{# sidecar is ordered After= it, so the chown has already happened, and doing #}
{# it twice doubles a cost that grows with the file count.                    #}
Volume={{ podman_service_name }}-{{ volume.name }}.volume:{{ volume.mount }}{{ ':U' if (volume.chown | default(false) and podman_service_parent_unit | length == 0) else '' }}
{% endfor %}
{% for mount in podman_service_container_spec.mounts | default([]) %}
Volume={{ mount.src }}:{{ mount.dst }}{{ ':ro' if mount.ro | default(true) else '' }}
{% endfor %}
{% for tmpfs in podman_service_container_spec.tmpfs | default([]) %}
Tmpfs={{ tmpfs }}
{% endfor %}
{% for key, value in (podman_service_container_spec.env | default({})).items() %}
Environment={{ key }}={{ value }}
{% endfor %}
{% for secret in podman_service_container_spec.secrets | default([]) %}
{% if secret.type | default('mount') == 'env' %}
Secret={{ podman_service_name }}-{{ secret.name }},type=env,target={{ secret.target }}
{% else %}
Secret={{ podman_service_name }}-{{ secret.name }},type=mount,target={{ secret.target | default('/run/secrets/' ~ secret.name) }},mode=0400
{% endif %}
{% endfor %}
DropCapability=all
{% if podman_service_container_spec.capabilities | default([]) | length > 0 %}
AddCapability={{ podman_service_container_spec.capabilities | join(' ') }}
{% endif %}
NoNewPrivileges={{ 'true' if podman_service_container_spec.no_new_privileges | default(true) else 'false' }}
ReadOnly={{ 'true' if podman_service_container_spec.read_only | default(true) else 'false' }}
ReadOnlyTmpfs=true
SeccompProfile=/usr/share/containers/seccomp.json
Mask=/proc/acpi:/proc/kcore:/proc/keys:/proc/timer_list:/proc/sched_debug:/proc/latency_stats:/sys/firmware
{% if podman_service_container_spec.exec is defined %}
Exec={{ podman_service_container_spec.exec }}
{% endif %}
PidsLimit={{ podman_service_container_limits.pids }}
{% if podman_service_container_spec.userns is defined %}
UserNS={{ podman_service_container_spec.userns }}
{% endif %}
{% if podman_service_container_spec.health is defined %}
HealthCmd={{ podman_service_container_spec.health.cmd }}
HealthInterval={{ podman_service_container_spec.health.interval | default('30s') }}
HealthStartPeriod={{ podman_service_container_spec.health.start_period | default('60s') }}
HealthRetries=3
HealthOnFailure=kill
{# Notify=healthy makes systemd hold the unit in `activating` until the       #}
{# container reports healthy. With no health check nothing ever reports, so   #}
{# the unit would never reach `active` and the start would time out. The two  #}
{# must appear and disappear together.                                        #}
Notify=healthy
{% endif %}
StopTimeout=30

[Service]
Restart=always
RestartSec=5
TimeoutStartSec={{ podman_service_container_limits.start_timeout | default(300) }}
MemoryMax={{ podman_service_container_limits.memory }}
CPUQuota={{ podman_service_container_limits.cpu }}
TasksMax={{ podman_service_container_limits.tasks }}

[Install]
WantedBy=default.target

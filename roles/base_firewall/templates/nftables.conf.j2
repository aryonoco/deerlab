#!/usr/sbin/nft -f
# {{ deerlab_managed }}
# Never `systemctl stop nftables`: Debian's unit flushes every rule on stop.
flush ruleset

table inet deerlab {
{% for name, svc in base_firewall_services.items() %}
  chain svc_{{ name }} {
{% if svc.egress == 'any' %}
    accept
{% elif svc.egress in ('web', 'platform') %}
{# The resolver accepts come first on purpose. drop is terminal, so if a #}
{# resolver ever sits inside a private range - a stub on 127.0.0.53, a LAN #}
{# resolver, a link-local metadata address - a drop placed above would make #}
{# its own accept unreachable and silently break DNS for the whole class. #}
{% for resolver in base_firewall_resolvers %}
    {{ 'ip6' if ':' in resolver else 'ip' }} daddr {{ resolver }} udp dport 53 accept
    {{ 'ip6' if ':' in resolver else 'ip' }} daddr {{ resolver }} tcp dport 53 accept
{% endfor %}
    ip daddr { {{ base_firewall_private_v4 | join(', ') }} } counter drop
    ip6 daddr { {{ base_firewall_private_v6 | join(', ') }} } counter drop
{# platform is web without port 80. Both still need DNS and 443, because the #}
{# service user itself pulls the image, runs restic and posts to Pushover. #}
{# No class can deny everything, which is why there is no longer one that #}
{# claims to. #}
    tcp dport { {{ '80, 443' if svc.egress == 'web' else '443' }} } accept
    limit rate 10/minute log prefix "nft-out-{{ name }} " level info
    counter drop
{% else %}
{# Unreachable: base_firewall asserts the class. Kept anyway, because an empty #}
{# chain returns to output, whose policy is accept - deleting this branch #}
{# would turn a typo into a service with no egress control at all. #}
    limit rate 10/minute log prefix "nft-out-{{ name }} " level info
    counter drop
{% endif %}
  }

{% endfor %}
  chain input {
    type filter hook input priority filter; policy drop;
    ct state established,related accept
    ct state invalid drop
    iifname "lo" accept
    meta l4proto icmp icmp type { echo-request, destination-unreachable, time-exceeded, parameter-problem } accept
    meta l4proto icmpv6 icmpv6 type { echo-request, destination-unreachable, packet-too-big, time-exceeded, parameter-problem, nd-neighbor-solicit, nd-neighbor-advert, nd-router-advert, nd-router-solicit, mld-listener-query } accept
    tcp dport {{ base_firewall_ssh_port }} ct state new limit rate 10/minute burst 10 packets accept
{% if base_firewall_role == 'edge' %}
    tcp dport { {{ base_firewall_edge_tcp_redirects.values() | join(', ') }} } accept
    udp dport { {{ base_firewall_edge_udp_redirects.values() | join(', ') }} } accept
    udp dport {{ base_firewall_wg_port }} accept
{% else %}
{% if base_firewall_peer_public_v4 | length > 0 %}
    ip saddr {{ base_firewall_peer_public_v4 }} udp dport {{ base_firewall_wg_port }} ct state new accept
{% endif %}
{% for proto, ports in [('tcp', base_firewall_backend_tcp_ports), ('udp', base_firewall_backend_udp_ports)] %}
{% if ports | length > 0 %}
    iifname "{{ base_firewall_wg_interface }}" ip saddr {{ base_firewall_peer_ipv4 }} {{ proto }} dport { {{ ports | join(', ') }} } ct state new accept
{% if base_firewall_peer_ipv6 | length > 0 %}
    iifname "{{ base_firewall_wg_interface }}" ip6 saddr {{ base_firewall_peer_ipv6 }} {{ proto }} dport { {{ ports | join(', ') }} } ct state new accept
{% endif %}
{% endif %}
{% endfor %}
{% endif %}
    limit rate 5/minute log prefix "nft-in-drop " level info
  }

  chain forward {
    type filter hook forward priority filter; policy drop;
  }

  chain output {
    type filter hook output priority filter; policy accept;
    ct state established,related accept
    ct state invalid drop
    meta skuid 0 accept
{% for name, svc in base_firewall_services.items() %}
    meta skuid {{ svc.uid }} jump svc_{{ name }}
{% endfor %}
{# Below the per-UID jumps on purpose. Linux routes a packet addressed to any #}
{# local address out lo - 127.0.0.0/8, the host's own public addresses and #}
{# its own tunnel address alike - so an accept placed above the jumps exempts #}
{# every egress class from its own rules, and a request-forgery bug in a #}
{# confined service could reach sshd or anything a neighbour publishes on the #}
{# wildcard address. The svc chains emit their resolver accepts before the #}
{# private-range drops, so a loopback stub resolver keeps working from here. #}
    oifname "lo" accept
  }
{% if base_firewall_role == 'edge' %}

  chain prerouting_nat {
    type nat hook prerouting priority dstnat; policy accept;
{% for from, to in base_firewall_edge_tcp_redirects.items() %}
    iifname != "lo" tcp dport {{ from }} redirect to :{{ to }}
{% endfor %}
{% for from, to in base_firewall_edge_udp_redirects.items() %}
    iifname != "lo" udp dport {{ from }} redirect to :{{ to }}
{% endfor %}
  }
{% endif %}
}
